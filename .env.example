# Скопируй в .env и подстрой. Всё остаётся ЛОКАЛЬНО — никаких внешних эндпоинтов по дизайну.

# Рендеринг
DOCUMASK_DPI=300                      # ниже 250 не опускай, иначе OCR мелкого текста деградирует

# Модели
DOCUMASK_YOLO_ONNX_PATH=models/stamps_sign.onnx
DOCUMASK_YOLO_CONF=0.25               # НИЗКИЙ намеренно: для комплаенса recall > precision
DOCUMASK_YOLO_IOU=0.45

# OCR
DOCUMASK_OCR_LANG=ru
DOCUMASK_OCR_USE_GPU=false

# Маскирование
DOCUMASK_MASK_MODE=fill               # fill | blur  (fill = необратимый чёрный прямоугольник)
DOCUMASK_MASK_PADDING_PX=6            # расширять каждый бокс, чтобы не было утечки по краю

# Хранилище
DOCUMASK_WORK_DIR=./_work             # входы/выходы джобов (монтируй volume в Docker)
DOCUMASK_DB_PATH=./_work/documask.db  # SQLite: джобы + аудит-лог

# Верификация (критично для комплаенса)
DOCUMASK_VERIFY_ENABLED=true          # повторный OCR результата, fail если ПДн всё ещё извлекаемы
DOCUMASK_VERIFY_STRICT=true           # если true, любая утечка => джоб FAILED, а не COMPLETED
